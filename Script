local function getGuiParent()
    local ok, ui = pcall(function() return gethui and gethui() end)
    if ok and ui then return ui end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then
        local t = Instance.new("Folder")
        local ok3 = pcall(function() t.Parent = cg end)
        if ok3 and t.Parent == cg then
            t:Destroy()
            return cg
        end
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeGui(name, order)
    local g = new("ScreenGui", {
        Name = name, ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = order, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = getGuiParent(),
    })
    Roots[#Roots + 1] = g
    return g
end

