        local function label()
            for _, o in ipairs(options) do
                if o[1] == tbl[key] then return o[2] end
            end
            return tostring(tbl[key])
        end
        btn.Text = label()
        track(btn.Activated:Connect(function()
            local idx = 1
            for i, o in ipairs(options) do
                if o[1] == tbl[key] then idx = i break end
            end
            idx = idx % #options + 1
            tbl[key] = options[idx][1]
            btn.Text = options[idx][2]
            if cb then pcall(cb, tbl[key]) end
            saveConfig()
