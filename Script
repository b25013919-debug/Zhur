local function updateCrosshair(vp)
    local on = S.Misc.Crosshair
    CrossDot.Visible = on
    for i = 1, 4 do CrossParts[i].Visible = on end
    if not on then return end
    local cx, cy = vp.X / 2, vp.Y / 2
    local len, gap, th = S.Misc.CrossSize, 3, 2
    local col = Theme.Accent
    CrossDot.Position = UDim2.fromOffset(cx, cy)
    CrossDot.BackgroundColor3 = col
    local off = gap + len / 2
    CrossParts[1].Size = UDim2.fromOffset(th, len)
    CrossParts[1].Position = UDim2.fromOffset(cx, cy - off)
    CrossParts[2].Size = UDim2.fromOffset(th, len)
    CrossParts[2].Position = UDim2.fromOffset(cx, cy + off)
    CrossParts[3].Size = UDim2.fromOffset(len, th)
    CrossParts[3].Position = UDim2.fromOffset(cx - off, cy)
    CrossParts[4].Size = UDim2.fromOffset(len, th)
    CrossParts[4].Position = UDim2.fromOffset(cx + off, cy)
    for i = 1, 4 do CrossParts[i].BackgroundColor3 = col end
end

-- ---------- Общий шаг визуала (после камеры игры) ----------
local fpsAcc, fpsN, fpsShown, hudT = 0, 0, 60, 0
local function visStep(dt)
    if not Alive then return end
    local cam = getCamera()
    if not cam then return end
    local vp = cam.ViewportSize
    if not origFOV then origFOV = cam.FieldOfView end

    -- FOV камеры
    if S.Misc.FOVOn then
        cam.FieldOfView = S.Misc.FOV
        fovApplied = true
    elseif fovApplied then
        cam.FieldOfView = origFOV
        fovApplied = false
    end

    -- FOV-круг аимбота
    local showFov = S.Aim.Enabled and S.Aim.ShowFOV
    FOVCircle.Visible = showFov
    if showFov then
        FOVCircle.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
        FOVCircle.Size = UDim2.fromOffset(S.Aim.FOV * 2, S.Aim.FOV * 2)
        FOVStroke.Color = Theme.Accent
    end

    updateESP(cam, vp)
    updateRadar(cam)
    updateCrosshair(vp)

    -- HUD
    HUDLabel.Visible = S.Misc.HUD
    if S.Misc.HUD then
        fpsAcc += dt
        fpsN += 1
        if fpsAcc >= 0.5 then
            fpsShown = math.floor(fpsN / fpsAcc + 0.5)
            fpsAcc, fpsN = 0, 0
        end
        hudT += dt
        if hudT > 0.5 then
            hudT = 0
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            HUDLabel.Text = "FPS " .. fpsShown .. "   •   Ping " .. ping .. " ms"
        end
    end
end

