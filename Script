    o.Name = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 14), AnchorPoint = Vector2.new(0.5, 1),
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0.4, Visible = false, Parent = Overlay,
    })
    o.Info = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 14), AnchorPoint = Vector2.new(0.5, 0),
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0.4, Visible = false, Parent = Overlay,
    })
    o.HPBack = new("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35,
        BorderSizePixel = 0, Visible = false, Parent = Overlay,
    })
    o.HPFill = new("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 1),
        BorderSizePixel = 0, Parent = o.HPBack,
    })
    o.Tracer = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false, Parent = Overlay,
    })
    o.HL = new("Highlight", {
        FillTransparency = 0.55, OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false, Parent = Overlay,
    })
    o.sc, o.scT = 1, 0
    ESPObjs[plr] = o
    return o
end

local function hideESP(o)
    o.Box.Visible = false
    o.Name.Visible = false
    o.Info.Visible = false
    o.HPBack.Visible = false
    o.Tracer.Visible = false
    o.HL.Enabled = false
end

local function destroyESP(plr)
    local o = ESPObjs[plr]
    if o then
        for _, v in pairs(o) do
            if typeof(v) == "Instance" then pcall(function() v:Destroy() end) end
        end
        ESPObjs[plr] = nil
    end
    local d = RadarDots[plr]
    if d then
        d:Destroy()
        RadarDots[plr] = nil
    end
    charCache[plr] = nil
end

local espWasOn = false
local function updateESP(cam, vp)
    local cfg = S.ESP
    if not cfg.Enabled then
        if espWasOn then
            espWasOn = false
            for _, o in pairs(ESPObjs) do hideESP(o) end
        end
        return
    end
    espWasOn = true
    local now = os.clock()
    local col = colorOf(cfg.Color)
    local camPos = cam.CFrame.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local o = ESPObjs[plr] or newESP(plr)
            local char = resolveCharacter(plr)
            local root = char and getRoot(char)
            local show = char and root and passesTeam(plr, cfg.TeamCheck) and isAlive(char)
            local dist = show and (root.Position - camPos).Magnitude or 0
            if show and dist > cfg.MaxDist then show = false end

            local top, bot
            if show then
                if now - o.scT > 1 then
                    pcall(function() o.sc = math.clamp(char:GetExtentsSize().Y / 5.4, 0.6, 2) end)
                    o.scT = now
                end
                top = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 2.8 * o.sc, 0))
                bot = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.2 * o.sc, 0))
                if top.Z <= 0 or bot.Z <= 0 then show = false end
            end

            if not show then
                hideESP(o)
            else
                local hgt = math.abs(bot.Y - top.Y)
                local wid = hgt * 0.55
                local cx = (top.X + bot.X) / 2
                local hp, mhp = getHealth(char)
                local frac = math.clamp(hp / mhp, 0, 1)

                -- Бокс
                o.Box.Visible = cfg.Box
                if cfg.Box then
                    o.Box.Position = UDim2.fromOffset(cx - wid / 2, top.Y)
                    o.Box.Size = UDim2.fromOffset(wid, hgt)
                    o.BoxStroke.Color = col
                end
                -- Ник
                o.Name.Visible = cfg.Name
                if cfg.Name then
                    o.Name.Text = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
                    o.Name.TextColor3 = col
                    o.Name.Position = UDim2.fromOffset(cx, top.Y - 2)
                end
                -- HP + дистанция
                local parts = {}
                if cfg.Health then parts[#parts + 1] = math.floor(hp) .. " HP" end
                if cfg.Distance then parts[#parts + 1] = math.floor(dist) .. "m" end
                o.Info.Visible = #parts > 0
                if #parts > 0 then
                    o.Info.Text = table.concat(parts, "  •  ")
                    o.Info.Position = UDim2.fromOffset(cx, bot.Y + 2)
                end
                -- Полоска HP
                o.HPBack.Visible = cfg.Health and cfg.Box
                if o.HPBack.Visible then
                    o.HPBack.Position = UDim2.fromOffset(cx - wid / 2 - 6, top.Y)
                    o.HPBack.Size = UDim2.fromOffset(3, hgt)
                    o.HPFill.Size = UDim2.fromScale(1, frac)
                    o.HPFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(70, 255, 120), frac)
                end
                -- Трассер
                o.Tracer.Visible = cfg.Tracers
                if cfg.Tracers then
                    local from = Vector2.new(vp.X / 2, vp.Y)
                    local to = Vector2.new(cx, bot.Y)
                    local d = to - from
                    o.Tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
                    o.Tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
                    o.Tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
                    o.Tracer.BackgroundColor3 = col
                end
                -- Чамсы
                o.HL.Enabled = cfg.Chams
                if cfg.Chams then
                    o.HL.Adornee = char
                    o.HL.FillColor = col
                    o.HL.OutlineColor = Color3.new(1, 1, 1)
                end
            end
        end
    end
end

-- ---------- Радар ----------
local function updateRadar(cam)
    Radar.Visible = S.Misc.Radar
    if not S.Misc.Radar then return end
    local R = Radar.AbsoluteSize.X / 2
    local range = math.max(S.Misc.RadarRange, 10)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local dot = RadarDots[plr]
            if not dot then
                dot = new("Frame", {
                    Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5),
                    BorderSizePixel = 0, Visible = false, Parent = Radar,
                }, { corner(4) })
                RadarDots[plr] = dot
            end
            local char = resolveCharacter(plr)
            local root = char and getRoot(char)
            if root and isAlive(char) and passesTeam(plr, true) then
                local rel = cam.CFrame:PointToObjectSpace(root.Position)
                local v = Vector2.new(rel.X, rel.Z) / range
                if v.Magnitude > 1 then v = v.Unit end
                dot.Position = UDim2.fromOffset(R + v.X * (R - 5), R + v.Y * (R - 5))
                dot.BackgroundColor3 = colorOf(S.ESP.Color)
                dot.Visible = true
            else
                dot.Visible = false
            end
        end
    end
end

