local aimKeyHeld, aimBtnHeld, aimBtnInput = false, false, nil
local currentTarget = nil

local function validTarget(t, cam, center, maxFov)
    if not t or not t.plr or not t.plr.Parent then return false end
    local char = resolveCharacter(t.plr)
    if not char or char ~= t.char or not t.part or not t.part.Parent or not isAlive(char) then return false end
    if not passesTeam(t.plr, S.Aim.TeamCheck) then return false end
    local sp, on = cam:WorldToViewportPoint(t.part.Position)
    if not on or sp.Z <= 0 then return false end
    if (Vector2.new(sp.X, sp.Y) - center).Magnitude > maxFov then return false end
    if S.Aim.WallCheck and not isVisible(t.part, char) then return false end
    return true
end

local function findTarget(cam, center)
    local best, bestDist = nil, S.Aim.FOV
    local camPos = cam.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and passesTeam(plr, S.Aim.TeamCheck) then
            local char = resolveCharacter(plr)
            if char and isAlive(char) then
                local list = {}
                local function add(p) if p then list[#list + 1] = p end end
                if S.Aim.Part == "Closest" then
                    add(char:FindFirstChild("Head"))
                    add(getTorso(char))
                    add(getRoot(char))
                else
                    add(getAimPart(char, S.Aim.Part))
                end
                for _, part in ipairs(list) do
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on and sp.Z > 0 and (part.Position - camPos).Magnitude <= S.Aim.MaxDist then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < bestDist then
                            if not S.Aim.WallCheck or isVisible(part, char) then
                                best = { plr = plr, part = part, char = char }
                                bestDist = d
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function aimStep(dt)
    if not Alive then return end
    if not S.Aim.Enabled then
        currentTarget = nil
        return
    end
    local active = (S.Aim.Mode == "Always") or aimKeyHeld or aimBtnHeld
    if not active then
        currentTarget = nil
        return
    end
    local cam = getCamera()
    if not cam then return end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)

    -- Липкая цель: держим пока она валидна
    if not (S.Aim.Sticky and validTarget(currentTarget, cam, center, S.Aim.FOV * 1.25)) then
        currentTarget = findTarget(cam, center)
    end
    local t = currentTarget
    if not t then return end

    local aimPos = t.part.Position
    if S.Aim.Predict > 0 then
        aimPos = aimPos + t.part.AssemblyLinearVelocity * (S.Aim.Predict / 100)
    end

    local base = 1 - math.clamp(S.Aim.Smooth, 0, 97) / 100
    local alpha = 1 - (1 - base) ^ (math.clamp(dt, 0, 0.1) * 60)

    if S.Aim.Method == "Mouse" and Cap.mousemoverel then
        local sp = cam:WorldToViewportPoint(aimPos)
        pcall(mousemoverel, (sp.X - center.X) * alpha, (sp.Y - center.Y) * alpha)
    else
        local cf = cam.CFrame
        cam.CFrame = cf:Lerp(CFrame.new(cf.Position, aimPos), alpha)
    end
end

-- Триггербот: ищем игрока под прицелом
local function crosshairPlayer()
    local cam = getCamera()
    if not cam then return nil end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
    local ignore = { cam }
    if LocalPlayer.Character then ignore[#ignore + 1] = LocalPlayer.Character end
    rayParams.FilterDescendantsInstances = ignore
    local r = Workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)
    if not r then return nil end
    local inst = r.Instance
    while inst and inst ~= Workspace do
        local p = Players:FindFirstChild(inst.Name)
        if p and p:IsA("Player") then return p end
        inst = inst.Parent
    end
    return nil
end

local function doClick()
    if Cap.mouse1click then
        pcall(mouse1click)
        return
    end
    if VIM then
        local cam = getCamera()
        if not cam then return end
        local vp = cam.ViewportSize
        pcall(function()
            VIM:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 0)
            task.wait(0.02)
            VIM:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 0)
        end)
    end
end

local lastShot = 0
local function startLoops()
    -- Триггербот
    task.spawn(function()
        while Alive do
            task.wait(0.01)
            if S.Trigger.Enabled then
                local ok, plr = pcall(crosshairPlayer)
                if ok and plr and passesTeam(plr, true) then
                    local char = resolveCharacter(plr)
                    if char and isAlive(char) and (os.clock() - lastShot) * 1000 >= S.Trigger.Delay then
                        lastShot = os.clock()
                        doClick()
                    end
                end
            end
        end
    end)

    -- Свет
    task.spawn(function()
        local applied = false
        while Alive do
            local fb, nf = S.Misc.Fullbright, S.Misc.NoFog
            if fb or nf then
                applied = true
                pcall(function()
                    Lighting.Brightness = fb and 2 or origLight.Brightness
                    Lighting.ClockTime = fb and 14 or origLight.ClockTime
                    Lighting.GlobalShadows = (not fb) and origLight.GlobalShadows
                    Lighting.Ambient = fb and Color3.fromRGB(178, 178, 178) or origLight.Ambient
                    Lighting.OutdoorAmbient = fb and Color3.fromRGB(178, 178, 178) or origLight.OutdoorAmbient
                    Lighting.FogEnd = nf and 9e9 or origLight.FogEnd
                    Lighting.FogStart = nf and 9e9 or origLight.FogStart
                end)
            elseif applied then
                applied = false
                restoreLight()
            end
            task.wait(0.4)
        end
    end)

    -- Привязки к рендеру (после камеры игры, чтобы она не перезаписала наш поворот)
    pcall(function() RunService:UnbindFromRenderStep("ClaudeAim") end)
    pcall(function() RunService:UnbindFromRenderStep("ClaudeVis") end)
    RunService:BindToRenderStep("ClaudeAim", Enum.RenderPriority.Last.Value, aimStep)
    RunService:BindToRenderStep("ClaudeVis", Enum.RenderPriority.Last.Value + 1, visStep)

    track(Players.PlayerRemoving:Connect(destroyESP))
end

