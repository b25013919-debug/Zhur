local function runLoader()
    local cam = getCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(800, 400)
    local gui = makeGui("ClaudeSplash", 1000)
    local splashAlive = true

    local root = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        GroupTransparency = 1, Parent = gui,
    })
    local bgGrad = new("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(8, 8, 16), Color3.fromRGB(32, 16, 54)), Rotation = 0, Parent = root,
    })
    tween(root, 0.5, { GroupTransparency = 0 })

    task.spawn(function()
        while splashAlive and Alive do
            bgGrad.Rotation = (os.clock() * 18) % 360
            task.wait()
        end
    end)

    -- Частицы
    for _ = 1, 18 do
        task.spawn(function()
            local s = math.random(2, 5)
            local dot = new("Frame", {
                Size = UDim2.fromOffset(s, s), BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = 0.3 + math.random() * 0.5, BorderSizePixel = 0,
                Position = UDim2.fromScale(math.random(), math.random()), Parent = root,
            }, { corner(5) })
            while splashAlive and Alive and dot.Parent do
                local t = math.random(60, 120) / 10
                tween(dot, t, { Position = UDim2.new(dot.Position.X.Scale, 0, -0.1, 0) }, Enum.EasingStyle.Linear)
                task.wait(t)
                dot.Position = UDim2.fromScale(math.random(), 1.1)
            end
        end)
    end

    -- Логотип
    local word = "CLAUDE"
    local sz = math.clamp(math.floor(vp.Y * 0.16), 40, 80)
    local group = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(sz * 0.8 * #word + 20, sz * 1.2 + 50),
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Parent = root,
    }, { new("UIScale", { Name = "Sc" }) })
    local groupScale = group:FindFirstChild("Sc")
    local letters = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, sz * 1.2), Parent = group,
    }, {
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })
    for i = 1, #word do
        local holder = new("Frame", {
            BackgroundTransparency = 1, Size = UDim2.fromOffset(sz * 0.8, sz * 1.2), LayoutOrder = i, Parent = letters,
        })
        local lbl = new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 30),
            Text = word:sub(i, i), TextColor3 = Color3.new(1, 1, 1), TextTransparency = 1,
            Font = Enum.Font.GothamBlack, TextSize = sz, Parent = holder,
        }, {
            new("UIGradient", { Color = ColorSequence.new(Theme.Accent, Color3.fromRGB(90, 200, 255)), Rotation = 90 }),
        })
        task.delay((i - 1) * 0.09, function()
            tween(lbl, 0.55, { Position = UDim2.fromOffset(0, 0), TextTransparency = 0 }, Enum.EasingStyle.Back)
        end)
    end
    local line = new("Frame", {
        Size = UDim2.new(0, 0, 0, 2), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, sz * 1.2 + 4),
        BorderSizePixel = 0, Parent = group,
    }, { corner(1) })
    accent(line, "BackgroundColor3")
    local tag = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, sz * 1.2 + 12), BackgroundTransparency = 1,
        Text = "B L O X   S T R I K E   •   E D I T I O N", TextColor3 = Theme.Sub, TextTransparency = 1,
        Font = Enum.Font.GothamMedium, TextSize = 13, Parent = group,
    })
    task.wait(0.7)
    tween(line, 0.7, { Size = UDim2.new(0.75, 0, 0, 2) }, Enum.EasingStyle.Quint)
    tween(tag, 0.7, { TextTransparency = 0 })
    task.wait(1.6)

    -- Логотип уезжает наверх
    tween(group, 0.8, { Position = UDim2.fromScale(0.5, 0.19) }, Enum.EasingStyle.Quint)
    tween(groupScale, 0.8, { Scale = 0.55 }, Enum.EasingStyle.Quint)
    task.wait(0.6)

    -- ---------- Выбор устройства ----------
    local devFrame = new("CanvasGroup", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), GroupTransparency = 1, Parent = root,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36),
        BackgroundTransparency = 1, Text = "ВЫБЕРИ УСТРОЙСТВО", TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold, TextSize = 18, Parent = devFrame,
    })
    local ch = math.clamp(math.floor(vp.Y * 0.44), 150, 240)
    local cw = math.floor(ch * 0.95)
    local choice
    local cards = {}

    local function makeCard(kind, name, desc, xs)
        local card = new("Frame", {
            Size = UDim2.fromOffset(cw, ch), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(xs, 0, 0.66, 0),
            BackgroundColor3 = Color3.fromRGB(20, 20, 32), BorderSizePixel = 0, Parent = devFrame,
        }, {
            corner(16),
            new("UIStroke", { Name = "St", Color = Color3.fromRGB(60, 60, 90), Thickness = 2 }),
            new("UIScale", { Name = "Sc" }),
        })
        local st, sc = card:FindFirstChild("St"), card:FindFirstChild("Sc")
        local icon = new("Frame", {
            BackgroundTransparency = 1, Size = UDim2.fromOffset(ch * 0.58, ch * 0.58), AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, ch * 0.07), Parent = card,
        })
        if kind == "phone" then drawPhone(icon) else drawPC(icon) end
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, ch * 0.14), Position = UDim2.new(0, 0, 1, -ch * 0.3), BackgroundTransparency = 1,
            Text = name, TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 18, Parent = card,
        })
        local isSug = (kind == suggested)
        new("TextLabel", {
            Size = UDim2.new(1, -10, 0, ch * 0.12), Position = UDim2.new(0, 5, 1, -ch * 0.16), BackgroundTransparency = 1,
            Text = isSug and "★ Рекомендуется" or desc, TextColor3 = isSug and Theme.Accent or Theme.Sub,
            Font = Enum.Font.GothamMedium, TextSize = 12, TextWrapped = true, Parent = card,
        })
        local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = card })
        track(btn.MouseEnter:Connect(function()
            tween(st, 0.15, { Color = Theme.Accent })
            tween(sc, 0.15, { Scale = 1.04 })
        end))
        track(btn.MouseLeave:Connect(function()
            if choice then return end
            tween(st, 0.15, { Color = Color3.fromRGB(60, 60, 90) })
            tween(sc, 0.15, { Scale = 1 })
        end))
        track(btn.Activated:Connect(function()
            if choice then return end
            choice = kind
            tween(st, 0.15, { Color = Theme.Accent })
            tween(sc, 0.15, { Scale = 1.09 }, Enum.EasingStyle.Back)
        end))
        cards[kind] = card
    end
    makeCard("phone", "Телефон", "Крупные кнопки и AIM", 0.3)
    makeCard("pc", "ПК", "Мышь и клавиши", 0.7)
    tween(devFrame, 0.5, { GroupTransparency = 0 })

    repeat task.wait(0.05) until choice or not Alive
    if not Alive then return end
    applyDevice(choice)
    S.Device = choice
    saveConfig()
    local other = (choice == "phone") and "pc" or "phone"
    tween(cards[other], 0.4, { Position = UDim2.new(cards[other].Position.X.Scale, 0, 1.4, 0) })
    task.wait(0.55)
    tween(devFrame, 0.4, { GroupTransparency = 1 })
    task.wait(0.45)
    devFrame:Destroy()

    -- ---------- Лоадер ----------
    local barW = math.clamp(math.floor(vp.X * 0.5), 260, 420)
    local loadFrame = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })
    local status = new("TextLabel", {
        Size = UDim2.fromOffset(barW + 80, 22), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52),
        BackgroundTransparency = 1, Text = "Запуск...", TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium,
        TextSize = 16, Parent = loadFrame,
    })
    local barBg = new("Frame", {
        Size = UDim2.fromOffset(barW, 8), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6),
        BackgroundColor3 = Color3.fromRGB(32, 32, 48), BorderSizePixel = 0, Parent = loadFrame,
    }, { corner(4) })
    local barFill = new("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = barBg,
    }, {
        corner(4),
        new("UIGradient", { Color = ColorSequence.new(Theme.Accent, Color3.fromRGB(90, 200, 255)) }),
    })
    local pct = new("TextLabel", {
        Size = UDim2.fromOffset(80, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.66),
        BackgroundTransparency = 1, Text = "0%", TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold,
        TextSize = 14, Parent = loadFrame,
    })
    local logBox = new("Frame", {
        Size = UDim2.fromOffset(barW, 70), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.71),
        BackgroundTransparency = 1, ClipsDescendants = true, Parent = loadFrame,
    }, { new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }) })
    local logN = 0
    local function log(text, ok)
        logN += 1
        local l = new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = logN,
            Text = (ok == false and "✗  " or "✓  ") .. text, TextColor3 = (ok == false) and Color3.fromRGB(255, 110, 110) or Theme.Sub,
            Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
            Parent = logBox,
        })
        tween(l, 0.25, { TextTransparency = 0 })
        local kids = {}
        for _, k in ipairs(logBox:GetChildren()) do
            if k:IsA("TextLabel") then kids[#kids + 1] = k end
        end
        table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        while #kids > 4 do
            table.remove(kids, 1):Destroy()
        end
    end

    local gameName = "Roblox"
    local steps = {
        { "Loading assets • сервисы Roblox", function()
            return Players and RunService and TweenService and UserInputService and true
        end },
        { "Loading assets • тема и шрифты", function() return true end },
        { "Loading assets • данные игры", function()
            local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
            if ok and info and info.Name then gameName = info.Name end
            return true, "Игра: " .. gameName
        end },
        { "Loading functions • API экзекьютора", function()
            return true, Cap.Executor .. " • mousemoverel " .. (Cap.mousemoverel and "OK" or "нет")
                .. " • mouse1click " .. (Cap.mouse1click and "OK" or "нет")
        end },
        { "Loading functions • конфиг", function()
            return true, configLoaded and "Конфиг загружен" or "Новый конфиг"
        end },
        { "Loading functions • ESP, радар, прицел", function() buildOverlay() return true end },
        { "Loading functions • аимбот и триггербот", function() startLoops() return true end },
        { "Building menu • интерфейс", function() buildMenu() return true end },
    }

    for i, step in ipairs(steps) do
        status.Text = step[1] .. "..."
        local ok, res, extra = pcall(step[2])
        if ok and res then
            log(extra or step[1], true)
        else
            log(step[1] .. " — ошибка", false)
            warn("[Claude] " .. step[1] .. ": " .. tostring(res))
        end
        local a = i / #steps
        tween(barFill, 0.35, { Size = UDim2.fromScale(a, 1) })
        pct.Text = math.floor(a * 100) .. "%"
        task.wait(0.32)
    end
    status.Text = "Готово!"
    task.wait(0.6)

    splashAlive = false
    tween(root, 0.6, { GroupTransparency = 1 })
    task.wait(0.65)
    gui:Destroy()

    if setMenu then setMenu(true) end
    notify("Claude загружен • нажми C, чтобы скрыть меню", 3.5)
end

-- ============================================================
-- 9. ОЧИСТКА И ЗАПУСК
-- ============================================================
local function cleanup()
    Alive = false
    pcall(function() RunService:UnbindFromRenderStep("ClaudeAim") end)
    pcall(function() RunService:UnbindFromRenderStep("ClaudeVis") end)
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    table.clear(Conns)
    for _, r in ipairs(Roots) do pcall(function() r:Destroy() end) end
    table.clear(Roots)
    pcall(restoreLight)
    pcall(function()
        local cam = getCamera()
        if cam and origFOV and fovApplied then cam.FieldOfView = origFOV end
    end)
    env.ClaudeCleanup = nil
end
env.ClaudeCleanup = cleanup

task.spawn(function()
    local ok, err = pcall(runLoader)
    if not ok then
        warn("[Claude] Ошибка лоадера: " .. tostring(err))
        -- Запасной запуск без красивого интро
        pcall(function()
            if not Overlay then buildOverlay() end
            if not Main then
                startLoops()
                buildMenu()
            end
            if setMenu then setMenu(true) end
        end)
    end
end)
